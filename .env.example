# ==============================================================================
# GazRoute - Environment Configuration Template
# ==============================================================================

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/gaz

# Cryptography & JWT Security
SECRET_KEY=change-me-in-production-use-long-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP & Rate Limiting
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_SECONDS=600

# File Storage & CORS
MEDIA_ROOT=./media_store
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.gazroute.ma
ENV=dev  # dev (shows dev_code in response) or prod (strict real SMS dispatch)

# ==============================================================================
# SMS GATEWAY PROVIDERS CONFIGURATION
# Options for SMS_PROVIDER: 'stub', 'twilio', 'infobip', 'orange', 'custom'
# ==============================================================================
SMS_PROVIDER=stub
SMS_SENDER_NAME=GazRoute

# 1. Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# 2. Infobip (https://www.infobip.com - recommended for Morocco/EMEA)
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com

# 3. Orange SMS API (https://developer.orange.com)
ORANGE_CLIENT_ID=your_orange_client_id_here
ORANGE_CLIENT_SECRET=your_orange_client_secret_here
ORANGE_SENDER_ADDRESS=tel:+212000000000

# 4. Custom Telco SMS API / HTTP Webhook
CUSTOM_SMS_URL=https://api.sms-provider.com/v1/send
CUSTOM_SMS_BEARER_TOKEN=your_bearer_token_here

# ==============================================================================
# Web Dashboard (.env.local)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
